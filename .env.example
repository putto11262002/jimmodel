# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Better Auth Configuration
# Generate a random 32-character secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-characters
BETTER_AUTH_TRUST_HOST=true

# Email Provider (Optional - for email verification and password reset)
# Uncomment and configure if needed:
# EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# Resend Email Service for Contact Form Notifications
# Get your API key from https://resend.com/api-keys
# Required for email functionality to work
RESEND_API_KEY=re_xxx

# Contact form notification recipients (comma-separated email addresses)
# Required for email notifications to be sent
# For testing, use delivered@resend.dev (simulates successful delivery)
# For production, use actual admin email addresses
ADMIN_NOTIFICATION_EMAILS=delivered@resend.dev

# Email "From" address configuration (both required)
FROM_EMAIL=noreply@jimmodel.com
FROM_NAME=Jimmodel Contact Form
# Optional: Custom reply-to email address (defaults to form submitter email if not set)
# REPLY_TO_EMAIL=admin@jimmodel.com

# Cloudflare R2 Storage Configuration
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=jimmodel
# Public domain for R2 (set up via Cloudflare R2 custom domain or r2.dev public bucket)
R2_PUBLIC_DOMAIN=your-r2-public-domain.r2.dev
